{{- $envRaw := (include (joinPath .chezmoi.homeDir ".env")) -}}
{{- $env := dict -}}
{{- range (splitList "\n" $envRaw) -}}
  {{- if and (gt (len .) 0) (not (hasPrefix "#" .)) (contains "=" .) -}}
    {{- $k := (. | regexFind "^[^=]+") -}}
    {{- $v := (. | regexFind "[^=]*$") -}}
    {{- $env = merge $env (dict $k $v) -}}
  {{- end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "DS": {
      "api": "openai",
      "name": "DeepSeek",
      "options": {
        "apiKey": "{{ index $env "DEEPSEEK_API_KEY" }}",
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "evomap": {
      "api": "openai",
      "name": "EvoMap Gateway",
      "options": {
        "apiKey": "{{ index $env "EVOMAP_API_KEY" }}",
        "baseURL": "https://api.evomap.ai/v1"
      },
      "models": {
        "evomap-deepseek-v4-flash": {
          "id": "evomap-deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "evomap-kimi-k2.6": {
          "id": "evomap-kimi-k2.6",
          "name": "Kimi K2.6",
          "family": "kimi",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    },
    "opencode-go": {
      "api": "openai",
      "name": "OpenCode Go",
      "options": {
        "apiKey": "{{ index $env "OPENCODE_GO_API_KEY" }}",
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "api": "openai",
      "name": "Ollama Cloud",
      "options": {
        "apiKey": "{{ index $env "OLLAMA_API_KEY" }}",
        "baseURL": "https://ollama.com/v1"
      },
      "models": {
        "glm-5.2": {
          "id": "glm-5.2",
          "name": "GLM 5.2 (Ollama)",
          "family": "glm",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow"
  }
}
