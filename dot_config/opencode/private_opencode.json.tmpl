{{- $ds := (bitwarden "item" "API_DEEPSEEK") -}}
{{- $evo := (bitwarden "item" "API_EVOMAP") -}}
{{- $go := (bitwarden "item" "API_OPENCODE_GO") -}}
{{- $oll := (bitwarden "item" "API_OLLAMA") -}}
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "DS": {
      "api": "openai",
      "name": "DeepSeek",
      "options": {
        "apiKey": "{{ $ds.login.password }}",
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "evomap": {
      "api": "openai",
      "name": "EvoMap Gateway",
      "options": {
        "apiKey": "{{ $evo.login.password }}",
        "baseURL": "https://api.evomap.ai/v1"
      },
      "models": {
        "evomap-deepseek-v4-flash": {
          "id": "evomap-deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "evomap-kimi-k2.6": {
          "id": "evomap-kimi-k2.6",
          "name": "Kimi K2.6",
          "family": "kimi",
          "tool_call": true,
          "reasoning": true,
          "modalities": {
            "input": ["text", "image"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    },
    "opencode-go": {
      "api": "openai",
      "name": "OpenCode Go",
      "options": {
        "apiKey": "{{ $go.login.password }}",
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "api": "openai",
      "name": "Ollama Cloud",
      "options": {
        "apiKey": "{{ $oll.login.password }}",
        "baseURL": "https://ollama.com/v1"
      },
      "models": {
        "glm-5.2": {
          "id": "glm-5.2",
          "name": "GLM 5.2 (Ollama)",
          "family": "glm",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": "allow"
  }
}
