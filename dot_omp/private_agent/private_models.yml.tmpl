{{- $envRaw := (include (joinPath .chezmoi.homeDir ".env")) -}}
{{- $env := dict -}}
{{- range (splitList "\n" $envRaw) -}}
  {{- if and (gt (len .) 0) (not (hasPrefix "#" .)) (contains "=" .) -}}
    {{- $k := (. | regexFind "^[^=]+") -}}
    {{- $v := (. | regexFind "[^=]*$") -}}
    {{- $env = merge $env (dict $k $v) -}}
  {{- end -}}
{{- end -}}
# Custom providers for omp (~/.omp/agent/models.yml)
# Generated by chezmoi from private_models.yml.tmpl
# API keys are dynamically injected from ~/.env (NOT committed to git).
providers:
  deepseek:
    baseUrl: https://api.deepseek.com
    apiKey: {{ index $env "DEEPSEEK_API_KEY" }}
    api: openai-completions
    models:
      - id: deepseek-v4-flash
        name: DeepSeek V4 Flash (DS)
        api: openai-completions
        reasoning: false
        input: [text]
        cost:
          input: 1
          output: 2
          cacheRead: 0
          cacheWrite: 0
        contextWindow: 128000
        maxTokens: 8192
